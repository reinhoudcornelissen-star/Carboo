# ─── Helper ───────────────────────────────────────────────────────────────────
def _sectie(titel: str, kleur: str = "#f97316"):
    st.markdown(
        f'<div style="font-size:0.72rem;font-weight:700;color:{kleur};'
        f'letter-spacing:2px;margin:18px 0 8px;">{titel}</div>',
        unsafe_allow_html=True,
    )


def _card(inhoud: str):
    st.markdown(
        f'<div style="background:#0f172a;border:1px solid #1e293b;'
        f'border-radius:10px;padding:14px 16px;margin-bottom:10px;">{inhoud}</div>',
        unsafe_allow_html=True,
    )


def _score_kleur(score: int) -> str:
    if score >= 4: return "#22c55e"
    if score >= 3: return "#fbbf24"
    return "#ef4444"


def _score_label(score: int) -> str:
    labels = {1: "Zeer slecht", 2: "Slecht", 3: "Matig", 4: "Goed", 5: "Uitstekend"}
    return labels.get(score, "—")


